{
  "name": "k95s",
  "version": "0.1.0",
  "description": "k95s — Kubernetes UI with Windows 95 theme",
  "author": "k95s",
  "homepage": "https://github.com/k95s/k95s",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "ELECTRON_IS_DEV=1 electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "dev.k95s.app",
    "productName": "k95s",
    "copyright": "Copyright © 2026",
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "src/**",
      "icons/**"
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] }
      ],
      "category": "Development"
    },
    "dmg": {
      "title": "k95s ${version}"
    }
  },
  "dependencies": {
    "@kubernetes/client-node": "^0.21.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.8.1"
  }
}
